# 本番マイグレーション用（Git にコミットしない）
# 使い方:
#   cp .env.migrate.example .env.migrate
#   下のどちらか（または両方）を埋める
#
# 方法A — 手元から直接 migrate:
#   DATABASE_URL=（Render Postgres → Internal Database URL）
#   npm run db:migrate:production
#
# 方法B — Render API で One-Off Job（おすすめ・DB URL 不要）:
#   RENDER_API_KEY=（Render → Account Settings → API Keys）
#   npm run render:one-off-migrate

DATABASE_URL=
RENDER_API_KEY=
