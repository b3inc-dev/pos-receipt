# ローカル開発用。cp .env.example .env のあと、値を開発用に置き換える。
# 変数名と非秘密の例だけを書く。本番の接続情報は書かない。
# 本番マイグレーション用は .env.migrate.example。このファイルとは別。

DATABASE_URL="postgresql://postgres:postgres@localhost:5432/pos_receipt?schema=public"

# npm run dev のとき Shopify CLI が補完することがある。
SHOPIFY_API_KEY=
SHOPIFY_API_SECRET=
SCOPES=read_orders,read_locations
SHOPIFY_APP_URL=http://localhost:3000

# 自社用の開発初期値。公開用との切替は別手順。
APP_DISTRIBUTION=inhouse
